{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=chatroom_dev.db"
  },
  "JwtSettings": {
    "SecretKey": "DevelopmentSecretKeyThatShouldBeAtLeast32CharactersLong",
    "Issuer": "ChatRoom.API.Dev",
    "Audience": "ChatRoom.Client.Dev",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  }
}
