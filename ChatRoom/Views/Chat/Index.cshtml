@{
    ViewData["Title"] = "ChatRoom";
    var username = ViewBag.Username as string;
}

<div class="container-fluid p-0" style="height: 100vh;">
    <div class="row g-0 h-100">
        <!-- Sidebar with users list -->
        <div class="col-md-3 bg-light border-end">
            <div class="p-3 border-bottom bg-primary text-white">
                <h5 class="mb-0">
                    👤 @username
                </h5>
                <small>Online Users</small>
            </div>
            <div id="users-list" class="p-3">
                <!-- Users will be populated here -->
            </div>
        </div>
        
        <!-- Chat area -->
        <div class="col-md-9 d-flex flex-column">
            <!-- Chat header -->
            <div id="chat-header" class="p-3 border-bottom bg-white" style="display: none;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0" id="chat-with-user">Select a user to start chatting</h6>
                        <small class="text-muted">Online</small>
                    </div>
                    <div>
                        <button class="btn btn-outline-success btn-sm me-2" id="audio-call-btn" title="Audio Call">
                            📞 Audio
                        </button>
                        <button class="btn btn-outline-primary btn-sm" id="video-call-btn" title="Video Call">
                            📹 Video
                        </button>
                    </div>
                </div>
            </div>
            
            <!-- Messages area -->
            <div id="messages-container" class="flex-grow-1 p-3 overflow-auto">
                <div class="text-center text-muted mt-5">
                    💬
                    <h5>Welcome to ChatRoom!</h5>
                    <p>Select a user from the left to start chatting</p>
                </div>
            </div>
            
            <!-- Message input -->
            <div id="message-input-area" class="p-3 border-top bg-light" style="display: none;">
                <div class="input-group">
                    <input type="text" class="form-control" id="message-input" placeholder="Type your message..." maxlength="500">
                    <button class="btn btn-primary" type="button" id="send-btn">
                        ➤ Send
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Call Modal -->
<div class="modal fade" id="callModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="callModalTitle">Incoming Call</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <div id="callContent">
                    <!-- Call content will be populated here -->
                </div>
                <div id="callControls" class="mt-3" style="display: none;">
                    <video id="localVideo" width="200" height="150" autoplay muted class="me-2"></video>
                    <video id="remoteVideo" width="200" height="150" autoplay></video>
                </div>
            </div>
            <div class="modal-footer" id="callModalFooter">
                <button type="button" class="btn btn-success" id="acceptCallBtn">
                    <i class="fas fa-phone"></i> Accept
                </button>
                <button type="button" class="btn btn-danger" id="rejectCallBtn">
                    <i class="fas fa-phone-slash"></i> Reject
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // HTTP-based real-time implementation using existing endpoints
        const username = '@username';
        let currentUser = null;
        let currentChatUser = null;
        let users = [];
        let messages = [];
        let pollingInterval = null;
        
        // Initialize connection using HTTP
        async function initializeConnection() {
            try {
                // Join chat on server and get user object
                const response = await fetch('/Chat/JoinChat', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(username)
                });
                
                const result = await response.json();
                
                if (!result.success) {
                    alert(result.message);
                    window.location.href = '/';
                    return;
                }
                
                // Store current user from server response
                currentUser = result.user;
                
                // Start polling for updates
                startPolling();
                
                console.log("Chat initialized for user:", currentUser);
                
            } catch (err) {
                console.error("Connection Error: ", err);
                setTimeout(initializeConnection, 5000);
            }
        }
        
        // Start polling for user list updates
        function startPolling() {
            // Load users immediately
            loadUsers();
            
            // Poll for user updates every 2 seconds
            pollingInterval = setInterval(async () => {
                await loadUsers();
            }, 2000);
        }
        
        // Load users from server
        async function loadUsers() {
            try {
                const response = await fetch('/Chat/GetUsers');
                const serverUsers = await response.json();
                
                // Filter out current user and update users list
                const otherUsers = serverUsers.filter(u => u.username !== username);
                
                // Check if users list changed
                if (JSON.stringify(otherUsers) !== JSON.stringify(users)) {
                    users = otherUsers;
                    updateUsersList();
                }
                
            } catch (error) {
                console.error('Error loading users:', error);
            }
        }
        
        // Update users list
        function updateUsersList() {
            const usersList = document.getElementById('users-list');
            usersList.innerHTML = '';
            
            if (users.length === 0) {
                usersList.innerHTML = '<div class="text-muted text-center p-3">No other users online</div>';
                return;
            }
            
            users.forEach(user => {
                addUserToList(user);
            });
        }
        
        // Add user to list
        function addUserToList(user) {
            const usersList = document.getElementById('users-list');
            const userDiv = document.createElement('div');
            userDiv.className = 'user-item p-2 border-bottom';
            userDiv.style.cursor = 'pointer';
            userDiv.setAttribute('data-user-id', user.id);
            userDiv.innerHTML = `
                <div class="d-flex align-items-center">
                    <div class="bg-success rounded-circle me-2" style="width: 10px; height: 10px;"></div>
                    <div>
                        <div class="fw-bold">${user.username}</div>
                        <small class="text-muted">Online</small>
                    </div>
                </div>
            `;
            
            userDiv.addEventListener('click', () => selectUser(user));
            usersList.appendChild(userDiv);
        }
        
        // Select user for chat
        function selectUser(user) {
            currentChatUser = user;
            
            // Update UI
            document.getElementById('chat-with-user').textContent = user.username;
            document.getElementById('chat-header').style.display = 'block';
            document.getElementById('message-input-area').style.display = 'block';
            
            // Clear default message
            document.getElementById('messages-container').innerHTML = '';
            
            // Load chat history
            loadChatHistory(user.id);
            
            // Highlight selected user
            document.querySelectorAll('.user-item').forEach(item => {
                item.classList.remove('bg-primary', 'text-white');
            });
            const selectedUserElement = document.querySelector(`[data-user-id="${user.id}"]`);
            if (selectedUserElement) {
                selectedUserElement.classList.add('bg-primary', 'text-white');
            }
        }
        
        // Load chat history
        async function loadChatHistory(userId) {
            try {
                // For demo purposes, create some sample history
                const sampleMessages = [
                    {
                        id: 'msg1',
                        fromUserId: userId,
                        toUserId: currentUser.id,
                        fromUsername: currentChatUser.username,
                        toUsername: currentUser.username,
                        message: `Hello ${currentUser.username}! Great to see you online.`,
                        timestamp: new Date(Date.now() - 300000).toISOString() // 5 minutes ago
                    }
                ];
                
                sampleMessages.forEach(message => {
                    displayMessage(message);
                });
                
            } catch (error) {
                console.error('Error loading chat history:', error);
            }
        }
        
        // Display message
        function displayMessage(message) {
            const messagesContainer = document.getElementById('messages-container');
            const isMyMessage = currentUser && message.fromUserId === currentUser.id;
            
            const messageDiv = document.createElement('div');
            messageDiv.className = `mb-3 d-flex ${isMyMessage ? 'justify-content-end' : 'justify-content-start'}`;
            
            messageDiv.innerHTML = `
                <div class="message-bubble ${isMyMessage ? 'bg-primary text-white' : 'bg-light'} p-2 rounded" style="max-width: 70%;">
                    <div class="fw-bold">${isMyMessage ? 'You' : message.fromUsername}</div>
                    <div>${message.message}</div>
                    <small class="text-${isMyMessage ? 'light' : 'muted'}">${new Date(message.timestamp).toLocaleTimeString()}</small>
                </div>
            `;
            
            messagesContainer.appendChild(messageDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }
        
        // Send message
        async function sendMessage() {
            const messageInput = document.getElementById('message-input');
            const messageText = messageInput.value.trim();
            
            if (!messageText || !currentChatUser) return;
            
            try {
                // Create message object
                const message = {
                    id: 'msg_' + Date.now(),
                    fromUserId: currentUser.id,
                    toUserId: currentChatUser.id,
                    fromUsername: currentUser.username,
                    toUsername: currentChatUser.username,
                    message: messageText,
                    timestamp: new Date().toISOString()
                };
                
                // Display message immediately (optimistic UI)
                displayMessage(message);
                messageInput.value = '';
                
                // For demo purposes, simulate a response from the other user
                setTimeout(() => {
                    const response = {
                        id: 'msg_' + Date.now(),
                        fromUserId: currentChatUser.id,
                        toUserId: currentUser.id,
                        fromUsername: currentChatUser.username,
                        toUsername: currentUser.username,
                        message: `Thanks for your message: "${messageText}". This is a real-time demo response!`,
                        timestamp: new Date().toISOString()
                    };
                    displayMessage(response);
                }, 1000);
                
            } catch (error) {
                console.error('Error sending message:', error);
            }
        }
        
        // Call functions
        async function startCall(callType) {
            if (!currentChatUser) return;
            
            alert(`${callType} call initiated with ${currentChatUser.username}. Real WebRTC implementation would start here.`);
        }
        
        // Event listeners
        document.getElementById('send-btn').addEventListener('click', sendMessage);
        document.getElementById('message-input').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                sendMessage();
            }
        });
        
        document.getElementById('audio-call-btn').addEventListener('click', () => startCall('Audio'));
        document.getElementById('video-call-btn').addEventListener('click', () => startCall('Video'));
        
        // Handle page unload
        window.addEventListener('beforeunload', function() {
            if (pollingInterval) {
                clearInterval(pollingInterval);
            }
        });
        
        // Initialize when page loads
        document.addEventListener('DOMContentLoaded', initializeConnection);
    </script>
    
    <style>
        .user-item:hover {
            background-color: #f8f9fa !important;
            cursor: pointer;
        }
        
        .message-bubble {
            word-wrap: break-word;
        }
        
        #messages-container {
            background-color: #fafafa;
        }
        
        .cursor-pointer {
            cursor: pointer;
        }
    </style>
}